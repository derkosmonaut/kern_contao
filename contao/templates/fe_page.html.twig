{% extends '@Contao/fe_page.html.twig' %}

{#
    KERN-Seitengerüst für das klassische Seitenlayout.
    Alles hier greift nur, wenn im Seitenlayout „KERN UX Standard verwenden“
    (tl_layout.kern_ux) aktiviert ist – sonst bleibt das Core-Markup unverändert.
#}
{% set kern = layout.kern_ux|default %}

{% block meta %}
    {{ parent() }}
    {% if kern %}
        {% include '@Contao/kern/_assets.html.twig' %}
    {% endif %}
{% endblock %}

{% block body %}
    {% if kern %}
        {% include '@Contao/kern/_skip_link.html.twig' %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {% if kern %}
        {% if header %}
            <header id="header">
                <div class="kern-container">
                    {{ header|raw }}
                </div>
            </header>
        {% endif %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block container %}
    {% if not kern %}
        {{ parent() }}
    {% elseif left or right %}
        <div id="container" class="kern-container">
            <div class="kern-row">
                {% if left %}
                    <aside id="left" class="kern-col-12 kern-col-md-3">
                        {{ left|raw }}
                    </aside>
                {% endif %}

                <div class="kern-col-12{% if left and right %} kern-col-md-6{% else %} kern-col-md-9{% endif %}">
                    {{ block('main') }}
                </div>

                {% if right %}
                    <aside id="right" class="kern-col-12 kern-col-md-3">
                        {{ right|raw }}
                    </aside>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div id="container">
            {{ block('main') }}
        </div>
    {% endif %}
{% endblock %}

{% block main %}
    {% if kern %}
        {# Ohne .inside: die Artikel bringen ihren eigenen kern-container mit #}
        <main id="main" tabindex="-1">
            {{ main|raw }}
            {{ contao_sections('main') }}
        </main>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block footer %}
    {% if kern %}
        {% if footer %}
            <footer id="footer">
                <div class="kern-container">
                    {{ footer|raw }}
                </div>
            </footer>
        {% endif %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
