{% extends '@Contao/content_element/hyperlink.html.twig' %}

{% block text_link %}
    {{- text_before -}}
    {% if data.kern_button_style|default %}
        <a{{ attrs(link_attributes|default).addClass(['kern-btn', 'kern-btn--' ~ data.kern_button_style]) }}>
            <span class="kern-label">{{ link_text|insert_tag }}</span>
        </a>
    {% else %}
        <a{{ attrs(link_attributes|default).addClass('kern-link') }}>{{ link_text|insert_tag }}</a>
    {% endif %}
    {{- text_after -}}
{% endblock %}
