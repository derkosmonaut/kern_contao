{% trans_default_domain 'contao_default' %}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_headline.html.twig' %}

{% set headline = teaser_headline|default({tag_name: 'h2', text: article.title}) %}

{% block content %}
    <article{{ attrs(teaser_attributes|default).addClass('kern-card') }}>
        <div class="kern-card__container">
            <header class="kern-card__header">
                {% with {headline: headline} %}{{ block('headline_component') }}{% endwith %}
            </header>

            {% block teaser %}
                <section class="kern-card__body">
                    {{ article.teaser|default|sanitize_html('contao')|insert_tag_raw }}
                </section>
            {% endblock %}

            {% block link %}
                <footer class="kern-card__footer">
                    {% set teaser_link_attributes = attrs()
                        .addClass(['kern-btn', 'kern-btn--secondary'])
                        .set('href', href)
                        .set('title', 'MSC.readMore'|trans([article.title]))
                    %}
                    <a{{ teaser_link_attributes }}>
                        <span class="kern-label">{{ 'MSC.readMore'|trans([article.title]) }}</span>
                    </a>
                </footer>
            {% endblock %}
        </div>
    </article>
{% endblock %}
