{% extends '@Contao/content_element/text.html.twig' %}

{% block inner %}
    {% if kern_alert_style|default %}
        <div class="kern-alert kern-alert--{{ kern_alert_style }}" role="alert">
            <div class="kern-alert__header">
                <span class="kern-icon kern-icon--{{ kern_alert_style }}" aria-hidden="true"></span>
                {% if headline.text|default %}
                    <span class="kern-title">{{ headline.text|insert_tag_raw }}</span>
                {% endif %}
            </div>
            <div class="kern-alert__body">
                {{ block('content') }}
            </div>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
