{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_figure.html.twig' %}

{% set attributes = attrs(attributes|default)
    .addClass("content-#{type}--cols-#{items_per_row|default(4)}")
%}

{% set column_class = 'kern-col-md-' ~ ((12 / (items_per_row|default(4)))|round) %}

{% block content %}
    <div class="kern-row">
        {% for image in images %}
            {% block gallery_item %}
                <div class="kern-col-12 kern-col-sm-6 {{ column_class }}">
                    {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
                </div>
            {% endblock %}
        {% endfor %}
    </div>
{% endblock %}
