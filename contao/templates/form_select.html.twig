{% set wrapperAttributes = attrs()
    .addClass([this.prefix, 'kern-form-input', this.class|default])
    .addClass('kern-form-input--error', hasErrors.invoke())
    .mergeWith(wrapperAttributes|default)
%}

<div{{ wrapperAttributes }}>
    {% block label %}
        {% if this.label %}
            <label class="kern-label" for="ctrl_{{ this.id }}">
                {% if this.mandatory|default %}
                    <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_raw }}<span class="mandatory">*</span>
                {% else %}
                    {{ this.label|insert_tag_raw }}
                {% endif %}
            </label>
        {% endif %}
    {% endblock %}

    {% block field %}
        {% if hasErrors.invoke() %}
            <p class="kern-error">{{ getErrorAsString.invoke() }}</p>
        {% endif %}

        {% if this.multiple|default %}
            <input type="hidden" name="{{ this.name ends with '[]' ? this.name[:-2] : this.name }}" value="">
        {% endif %}

        <div class="kern-form-input__select-wrapper">
            <select{{ attrs()
                .set('name', this.name)
                .set('id', "ctrl_#{this.id}")
                .addClass('kern-form-input__select')
                .addClass('kern-form-input__select--error', hasErrors.invoke())
                .addClass(this.class|default)
                .set('aria-describedby', "help_ctrl_#{this.id}", this.help|default)
                .mergeWith(getAttributes.invoke())
            }}>
                {% for option in getOptions.invoke() %}
                    {% if option.type == 'group_start' %}
                        <optgroup label="{{ option.label }}">
                    {% endif %}

                    {% if option.type == 'option' %}
                        <option value="{{ option.value }}"{{ option.selected }}>{{ option.label }}</option>
                    {% endif %}

                    {% if option.type == 'group_end' %}
                        </optgroup>
                    {% endif %}
                {% endfor %}
            </select>
        </div>

        {% if this.help|default %}
            <p class="kern-hint" id="help_ctrl_{{ this.id }}">{{ this.help|insert_tag_raw }}</p>
        {% endif %}
    {% endblock %}
</div>
